{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-study public dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "series", "generated_at", "datasets", "excluded_candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "multi-story-building-public-experiments"},
    "series": {"const": "MULTI-STUDY"},
    "generated_at": {"type": ["string", "null"]},
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "program_id",
          "status",
          "source_record_id",
          "included_surfaces",
          "excluded_surfaces",
          "sanitization_summary",
          "claim_boundary"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "pattern": "^datasets/public/[a-z0-9][a-z0-9-]*$"},
          "program_id": {"type": "string", "pattern": "^(MSB|UGRR)[0-9]{2}$"},
          "status": {
            "enum": ["publication-candidate-not-claim-grade", "published", "published-not-claim-grade", "published-claim-grade"]
          },
          "source_record_id": {"type": "string", "pattern": "^SRC-[A-Z0-9]{12}$"},
          "included_surfaces": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"}
          },
          "excluded_surfaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "sanitization_summary": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "claim_boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "excluded_candidates": {"type": "array", "items": {"type": "string"}}
  }
}
