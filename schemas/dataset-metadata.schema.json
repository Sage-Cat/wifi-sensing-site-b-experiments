{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-study public bundle metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "series",
    "program_id",
    "description",
    "evidence_status",
    "abstract_site",
    "abstract_levels",
    "abstract_zones",
    "time_basis",
    "human_context",
    "privacy_review",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "series": {"enum": ["MSB", "UGRR"]},
    "program_id": {"type": "string", "pattern": "^(MSB|UGRR)[0-9]{2}$"},
    "description": {"type": "string", "minLength": 1},
    "evidence_status": {
      "enum": ["publication-candidate-not-claim-grade", "published", "published-not-claim-grade", "published-claim-grade"]
    },
    "abstract_site": {"type": "string", "pattern": "^site-S[0-9]{2}$"},
    "abstract_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^level-L[0-9]{2}$"}
    },
    "abstract_zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^zone-Z[0-9]{2}$"}
    },
    "time_basis": {"enum": ["relative", "coarsened"]},
    "human_context": {
      "enum": ["instrument-only", "controlled-consented", "unlabelled-environment"]
    },
    "privacy_review": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
